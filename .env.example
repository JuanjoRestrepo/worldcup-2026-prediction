# Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ── PostgreSQL / Supabase ─────────────────────────────────────────────────────
# ⚠️  IMPORTANT: Always use the SESSION POOLER host, NOT the Direct Connection.
#
#   Direct Connection  →  db.<project-ref>.supabase.co      (IPv6 only — times out!)
#   Session Pooler     →  aws-0-<region>.pooler.supabase.com (IPv4  ✅  use this)
#
# Where to find it:
#   Supabase dashboard → Project Settings → Database → Connection string
#   Select the "Session Pooler" tab (NOT "Direct connection").
#   Mode = "Session" (not Transaction — Transaction mode breaks prepared statements).
#
POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.xxxxxxxxxxxxxxxxxxxx
POSTGRES_PASSWORD=your-supabase-db-password


# ── dbt schema prefix ─────────────────────────────────────────────────────────
DBT_BASE_SCHEMA=analytics

# ── Feature serving ───────────────────────────────────────────────────────────
# Options: csv | postgres | dbt | auto
# Use 'csv' for local dev and Render free tier (no DB required for predictions)
PREDICTION_FEATURE_SOURCE=csv

# ── Monitoring source ─────────────────────────────────────────────────────────
# Options: auto | dbt | postgres
MONITORING_SOURCE=auto

# ── API security ──────────────────────────────────────────────────────────────
# Admin endpoints (/admin/toggle-shadow etc.) require this key in X-Admin-Key header
ADMIN_API_KEY=your-secret-admin-key-change-this

# ── API server (local) ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Model artifact path ───────────────────────────────────────────────────────
# Relative to repo root. Do not change unless you move the artifact.
MODEL_ARTIFACT_PATH=models/match_predictor.joblib

# ── Football-Data API (optional — for live data ingestion only) ───────────────
FOOTBALL_API_KEY=your-football-data-api-key
